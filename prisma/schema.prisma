generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                     String           @id @default(cuid())
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  config                 Json?
  validationErrors       Float[]          @default([])
  meanErrorPx            Float?
  /// 'in_progress' from the moment demographics are submitted, patched at every
  /// break, then 'completed' once calibration finishes. A row stuck on
  /// 'in_progress' is a participant who did not finish — visible and
  /// inspectable now, instead of leaving no record at all.
  status                 String?          @default("in_progress")
  videoUrl               String?
  calibrationImageUrls   Json?
  calibrationGazeSamples Json?
  /// Per-dot [t_start, t_end] windows on the recorded video's own clock, plus
  /// screen geometry — what `backend/app/reprocess.py` needs to re-fit gaze
  /// from the raw video later. Built for every session, not just debug runs;
  /// without it the video alone cannot be re-aligned to what the participant
  /// was looking at.
  calibrationMeta        Json?
  demographics           Json?
  /// Participant-supplied email. Indexed so the same person can be found across runs.
  participantEmail       String?
  /// Assessment module that produced this row. Kept as a string so new
  /// modules can be added without a PostgreSQL enum migration.
  assessmentType         String?          @default("EYE_TRACKING")
  doctorId               String?
  patientId              String?
  invitationId           String?
  doctor                 User?            @relation("DoctorSessions", fields: [doctorId], references: [id], onDelete: SetNull)
  patient                User?            @relation("PatientSessions", fields: [patientId], references: [id], onDelete: SetNull)
  invitation             TestInvitation?  @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  neurologicalRun        NeurologicalRun?
  testRun                TestRun?

  @@index([participantEmail])
  @@index([status])
  @@index([doctorId, createdAt])
  @@index([patientId, createdAt])
  @@index([invitationId])
}

model TestRun {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  trajectories Json
  createdAt    DateTime @default(now())
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model NeurologicalTestConfig {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  name           String   @unique @default("default")
  testOrder      Json
  testParameters Json
  testEnabled    Json?
}

model NeurologicalRun {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  sessionId         String   @unique
  configSnapshot    Json?
  preSymptomScores  Json?
  postSymptomScores Json?
  testOrderSnapshot Json?
  testResults       Json?
  status            String   @default("in_progress")
  /// One continuous recording spanning the 7 tests — unlike calibration's
  /// video this has no other raw-frame fallback, so it is what a gaze
  /// algorithm revisited later would re-derive from. Null when recording is
  /// disabled (NEXT_PUBLIC_NEURO_RECORD_VIDEO=0) or failed to upload.
  videoUrl          String?
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AppConfig {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique @default("default")
  config    Json
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

/// Non-admin accounts used by clinicians and participants. Admins deliberately
/// remain in their existing table/cookie so portal roles can never acquire
/// system configuration permissions by accident.
model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String           @map("password_hash")
  name            String
  role            String           @default("PATIENT")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  invitations     TestInvitation[]
  doctorSessions  Session[]        @relation("DoctorSessions")
  patientSessions Session[]        @relation("PatientSessions")

  @@index([role])
  @@map("users")
}

model TestInvitation {
  id             String    @id @default(cuid())
  code           String    @unique
  assessmentType String
  doctorId       String
  expiresAt      DateTime?
  maxUses        Int       @default(1)
  usedCount      Int       @default(0)
  active         Boolean   @default(true)
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  doctor         User      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  sessions       Session[]

  @@index([doctorId, createdAt])
  @@index([active, expiresAt])
}
